{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",

    // The same strictness the backend and mobile run under. Infrastructure
    // mistakes are discovered slowly and expensively — at deploy, or later by a
    // user — so the compiler should catch what it can.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // exactOptionalPropertyTypes is deliberately absent, unlike in the backend
    // and mobile packages. aws-cdk-lib is not written for it: `Vpc` declares
    // `vpnGatewayId: string | undefined` while the `IVpc` it implements
    // declares `vpnGatewayId?: string`, so passing a VPC to any construct that
    // takes one fails to compile. The only way to satisfy the flag is to cast
    // at every boundary, which would hide real type errors to appease a
    // library's authoring style.

    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "cdk.out"]
}
