{
  "expo": {
    "name": "Archery Tracker",
    "slug": "archery-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "archerytracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.archerytracker.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph the target face so you can mark arrows over the real board."
      }
    },
    "android": {
      "package": "app.archerytracker.mobile",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191713"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@morrowdigital/watermelondb-expo-plugin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph the target face so you can mark arrows over the real board."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f7f4ec",
          "dark": {
            "backgroundColor": "#0e0d0b"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
