# Copy to .env for local development. Never commit a real .env.

# Local Docker Postgres from the repo root docker-compose.yml.
# In AWS this points at RDS Proxy, not the instance directly.
DATABASE_URL=postgresql://archery:archery_dev@localhost:5432/archery

PORT=3000
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
# In dev, leave the Cognito values unset and set DEV_USER_ID instead: every
# request is then treated as coming from that user, with no token required.
# The server refuses to start with DEV_USER_ID set unless NODE_ENV is
# development or test, so this cannot be shipped by accident.
DEV_USER_ID=11111111-1111-4111-8111-000000000000

# Required outside development. API Gateway's Cognito authorizer validates the
# token first; these let the app verify it again rather than trusting a header.
# COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Photos -----------------------------------------------------------------
# S3_BUCKET=archery-app-dev-round-photos
# AWS_REGION=eu-west-2
PRESIGNED_URL_TTL_SECONDS=900
